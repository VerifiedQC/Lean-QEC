import Mathlib
import LeanQEC.Stabilizer.CSS
import LeanQEC.Stabilizer.Subsystem.Basic

open Finset

/-!
# RLG subsystem codes

Physical qubits sit on an `l`-dimensional lattice with side lengths `q 0, …, q (l-1)`, each even
and at least 4. The gauge group is generated by `X` and `Z` on coordinate lines (all coordinates
fixed but one). Stabilizers are `X` or `Z` on a *box* of `2^(l-1)` parallel lines: in every
transverse axis the coordinate takes one of two chosen values. Evenness of the sides makes a
line commute with a parallel line it coincides with; the two-values-per-axis structure makes a
transverse line meet a box in exactly two qubits.
-/

structure RLG (l : ℕ) where
  q : Fin l → ℕ
  h_ge4 : ∀ i, 4 ≤ q i
  h_even : ∀ i, Even (q i)

namespace RLG
variable {l : ℕ} (r : RLG l)

def n : ℕ := ∏ i, r.q i
abbrev Coord := (i : Fin l) → Fin (r.q i)
def coordEquiv : r.Coord ≃ Fin r.n := finPiFinEquiv

theorem n_pos : 0 < r.n :=
  Finset.prod_pos fun i _ => by have := r.h_ge4 i; omega

/-! ### Product sets and their indicator vectors -/

/-- A per-axis constraint: the set of allowed values in each dimension. -/
abbrev AxisSet := (j : Fin l) → Finset (Fin (r.q j))

/-- Indicator vector (over flat qubit indices) of the product set `S 0 × S 1 × ⋯`. -/
def axisBox (S : r.AxisSet) : Fin r.n → ZMod 2 :=
  fun k => if r.coordEquiv.symm k ∈ Fintype.piFinset S then 1 else 0

/-- The overlap of two product sets is the product of the per-axis overlaps. -/
theorem axisBox_dot (S T : r.AxisSet) :
    r.axisBox S ⬝ᵥ r.axisBox T = ((∏ j, (S j ∩ T j).card : ℕ) : ZMod 2) := by
  classical
  unfold axisBox dotProduct
  simp_rw [mul_ite, mul_one, mul_zero, ← ite_and, ← Finset.mem_inter, ← Fintype.piFinset_inter]
  rw [Finset.sum_boole, ← Fintype.card_piFinset]
  congr 1
  rw [← Finset.card_map r.coordEquiv.toEmbedding]
  congr 1
  ext k
  simp [Finset.mem_map_equiv, and_comm]

/-- If two product sets have an even overlap along some axis, their dot product vanishes. -/
theorem axisBox_dot_eq_zero (S T : r.AxisSet) (j : Fin l) (h : Even (S j ∩ T j).card) :
    r.axisBox S ⬝ᵥ r.axisBox T = 0 := by
  rw [axisBox_dot, ← Finset.mul_prod_erase univ _ (mem_univ j), Nat.cast_mul]
  obtain ⟨m, hm⟩ := h
  rw [hm, ← two_mul, Nat.cast_mul, show ((2 : ℕ) : ZMod 2) = 0 from rfl, zero_mul, zero_mul]

/-! ### Lines and boxes -/

/-- The coordinate line through `c` in direction `i`. -/
def lineSet (i : Fin l) (c : r.Coord) : r.AxisSet :=
  fun j => if j = i then univ else {c j}

/-- The `2^(l-1)` parallel lines in direction `i` whose transverse coordinates are
`a j` or `b j` in every other axis `j`. -/
def boxSet (i : Fin l) (a b : r.Coord) : r.AxisSet :=
  fun j => if j = i then univ else {a j, b j}

/-- A box is non-degenerate when its two transverse values differ in every other axis. -/
def Nondeg (i : Fin l) (a b : r.Coord) : Prop := ∀ j, j ≠ i → a j ≠ b j

instance (i : Fin l) (a b : r.Coord) : Decidable (r.Nondeg i a b) := by
  unfold Nondeg; infer_instance

@[simp] lemma lineSet_self (i : Fin l) (c : r.Coord) : r.lineSet i c i = univ := by simp [lineSet]
lemma lineSet_ne {i j : Fin l} (c : r.Coord) (h : j ≠ i) : r.lineSet i c j = {c j} := by
  simp [lineSet, h]
@[simp] lemma boxSet_self (i : Fin l) (a b : r.Coord) : r.boxSet i a b i = univ := by simp [boxSet]
lemma boxSet_ne {i j : Fin l} (a b : r.Coord) (h : j ≠ i) : r.boxSet i a b j = {a j, b j} := by
  simp [boxSet, h]

/-- Gauge generator support: a single coordinate line. -/
def lineVec (i : Fin l) (c : r.Coord) : Fin r.n → ZMod 2 := r.axisBox (r.lineSet i c)

/-- Stabilizer generator support: a non-degenerate box of parallel lines (zero otherwise). -/
def boxVec (i : Fin l) (a b : r.Coord) : Fin r.n → ZMod 2 :=
  if r.Nondeg i a b then r.axisBox (r.boxSet i a b) else 0

/-- A line meets a box in an even number of qubits. -/
theorem line_dot_box (i i' : Fin l) (c a b : r.Coord) :
    r.lineVec i c ⬝ᵥ r.boxVec i' a b = 0 := by
  unfold lineVec boxVec
  split_ifs with hnd
  · by_cases h : i = i'
    · subst h
      apply r.axisBox_dot_eq_zero _ _ i
      rw [lineSet_self, boxSet_self, inter_self, card_univ, Fintype.card_fin]
      exact r.h_even i
    · apply r.axisBox_dot_eq_zero _ _ i
      rw [lineSet_self, r.boxSet_ne _ _ h, univ_inter, card_pair (hnd i h)]
      exact even_two
  · simp

/-- Two boxes meet in an even number of qubits. -/
theorem box_dot_box (i i' : Fin l) (a b a' b' : r.Coord) :
    r.boxVec i a b ⬝ᵥ r.boxVec i' a' b' = 0 := by
  unfold boxVec
  split_ifs with hnd hnd'
  · by_cases h : i = i'
    · subst h
      apply r.axisBox_dot_eq_zero _ _ i
      rw [boxSet_self, boxSet_self, inter_self, card_univ, Fintype.card_fin]
      exact r.h_even i
    · apply r.axisBox_dot_eq_zero _ _ i
      rw [boxSet_self, r.boxSet_ne _ _ h, univ_inter, card_pair (hnd' i h)]
      exact even_two
  all_goals simp

/-! ### The stabilizer code -/

/-- Rows of the stabilizer matrix: a direction and two points fixing the transverse values. -/
abbrev StabIdx := Fin l × r.Coord × r.Coord

/-- Both the X- and Z-type check matrices, indexed by their natural row type. -/
def stabMat : Matrix r.StabIdx (Fin r.n) (ZMod 2) :=
  fun p => r.boxVec p.1 p.2.1 p.2.2

/-- Flatten row indices to `Fin`, as `coe1`/`coe2` do for the toric code. -/
def stabIdxEquiv : r.StabIdx ≃ Fin (l * (r.n * r.n)) :=
  ((Equiv.refl _).prodCongr (r.coordEquiv.prodCongr r.coordEquiv)).trans
    (((Equiv.refl _).prodCongr finProdFinEquiv).trans finProdFinEquiv)

/-- The check matrix with rows relabelled by `Fin`, as `cssStabCode` requires. -/
def stabMat' : Matrix (Fin (l * (r.n * r.n))) (Fin r.n) (ZMod 2) :=
  Matrix.reindex r.stabIdxEquiv (Equiv.refl _) r.stabMat

/-- Row `j` of the flattened matrix is the box named by the triple `j` stands for. -/
@[simp] lemma stabMat'_apply (j : Fin (l * (r.n * r.n))) :
    r.stabMat' j = r.boxVec (r.stabIdxEquiv.symm j).1 (r.stabIdxEquiv.symm j).2.1
      (r.stabIdxEquiv.symm j).2.2 := rfl

theorem stabMat'_orth : r.stabMat'.mutually_orth_rows r.stabMat' :=
  fun _ _ => r.box_dot_box _ _ _ _ _ _

noncomputable def stabCode : StabCode r.n := cssStabCode r.stabMat' r.stabMat' r.stabMat'_orth

/-! ### The gauge group -/

def gaugeXGens : Set (PauliGroup_group r.n) :=
  Set.range (fun p : Fin l × r.Coord => xPauli (r.lineVec p.1 p.2))

def gaugeZGens : Set (PauliGroup_group r.n) :=
  Set.range (fun p : Fin l × r.Coord => zPauli (r.lineVec p.1 p.2))

def gaugeGens : Set (PauliGroup_group r.n) :=
  r.gaugeXGens ∪ r.gaugeZGens

def gauge : Subgroup (PauliGroup_group r.n) := Subgroup.closure r.gaugeGens

lemma xPauli_sum_mem {ι : Type*} (H : Subgroup (PauliGroup_group r.n)) (s : Finset ι)
    (f : ι → Fin r.n → ZMod 2) (hf : ∀ c ∈ s, xPauli (f c) ∈ H) :
    xPauli (∑ c ∈ s, f c) ∈ H := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty, xPauli_zero]; exact one_mem _
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, ← xPauli_mul]
    exact H.mul_mem (hf a (mem_insert_self _ _)) (ih fun c hc => hf c (mem_insert_of_mem hc))

lemma zPauli_sum_mem {ι : Type*} (H : Subgroup (PauliGroup_group r.n)) (s : Finset ι)
    (f : ι → Fin r.n → ZMod 2) (hf : ∀ c ∈ s, zPauli (f c) ∈ H) :
    zPauli (∑ c ∈ s, f c) ∈ H := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty, zPauli_zero]; exact one_mem _
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, ← zPauli_mul]
    exact H.mul_mem (hf a (mem_insert_self _ _)) (ih fun c hc => hf c (mem_insert_of_mem hc))

/-- One representative point per line of the box: coordinate `i` pinned to `a i`. -/
def corners (i : Fin l) (a b : r.Coord) : Finset r.Coord :=
  Fintype.piFinset fun j => if j = i then {a j} else {a j, b j}

lemma mem_line_iff {i : Fin l} {c x : r.Coord} :
    x ∈ Fintype.piFinset (r.lineSet i c) ↔ ∀ j, j ≠ i → x j = c j := by
  simp only [Fintype.mem_piFinset, lineSet]
  constructor
  · intro h j hj; have := h j; rwa [if_neg hj, mem_singleton] at this
  · intro h j
    split_ifs with hj
    · exact mem_univ _
    · rw [mem_singleton]; exact h j hj

lemma mem_box_iff {i : Fin l} {a b x : r.Coord} :
    x ∈ Fintype.piFinset (r.boxSet i a b) ↔ ∀ j, j ≠ i → x j = a j ∨ x j = b j := by
  simp only [Fintype.mem_piFinset, boxSet]
  constructor
  · intro h j hj; have := h j; rwa [if_neg hj, mem_insert, mem_singleton] at this
  · intro h j
    split_ifs with hj
    · exact mem_univ _
    · rw [mem_insert, mem_singleton]; exact h j hj

lemma mem_corners_iff {i : Fin l} {a b c : r.Coord} :
    c ∈ r.corners i a b ↔ c i = a i ∧ ∀ j, j ≠ i → c j = a j ∨ c j = b j := by
  simp only [corners, Fintype.mem_piFinset]
  constructor
  · intro h
    refine ⟨?_, fun j hj => ?_⟩
    · have := h i; rwa [if_pos rfl, mem_singleton] at this
    · have := h j; rwa [if_neg hj, mem_insert, mem_singleton] at this
  · rintro ⟨hi, h⟩ j
    split_ifs with hj
    · subst hj; rw [mem_singleton]; exact hi
    · rw [mem_insert, mem_singleton]; exact h j hj

/-- A non-degenerate box is the disjoint union of its `2^(l-1)` lines. -/
theorem boxVec_eq_sum {i : Fin l} {a b : r.Coord} (hnd : r.Nondeg i a b) :
    r.boxVec i a b = ∑ c ∈ r.corners i a b, r.lineVec i c := by
  classical
  ext k
  simp only [boxVec, if_pos hnd, axisBox, lineVec, Finset.sum_apply, Finset.sum_boole]
  set x := r.coordEquiv.symm k with hx
  by_cases hmem : x ∈ Fintype.piFinset (r.boxSet i a b)
  · rw [if_pos hmem]
    have : (r.corners i a b).filter (fun c => x ∈ Fintype.piFinset (r.lineSet i c))
        = {Function.update x i (a i)} := by
      ext c
      rw [mem_filter, mem_singleton, mem_corners_iff, mem_line_iff]
      constructor
      · rintro ⟨⟨hci, _⟩, hl⟩
        funext j
        by_cases hj : j = i
        · subst hj; rw [Function.update_self]; exact hci
        · rw [Function.update_of_ne hj]; exact (hl j hj).symm
      · rintro rfl
        refine ⟨⟨Function.update_self _ _ _, fun j hj => ?_⟩, fun j hj => ?_⟩
        · rw [Function.update_of_ne hj]; exact r.mem_box_iff.1 hmem j hj
        · rw [Function.update_of_ne hj]
    rw [this, card_singleton, Nat.cast_one]
  · rw [if_neg hmem]
    have : (r.corners i a b).filter (fun c => x ∈ Fintype.piFinset (r.lineSet i c)) = ∅ := by
      ext c
      rw [mem_filter, mem_corners_iff, mem_line_iff]
      simp only [notMem_empty, iff_false, not_and]
      rintro ⟨_, hc⟩ hl
      apply hmem
      rw [mem_box_iff]
      intro j hj
      rw [hl j hj]
      exact hc j hj
    rw [this, card_empty, Nat.cast_zero]

lemma xPauli_boxVec_mem (i : Fin l) (a b : r.Coord) : xPauli (r.boxVec i a b) ∈ r.gauge := by
  by_cases hnd : r.Nondeg i a b
  · rw [r.boxVec_eq_sum hnd]
    exact r.xPauli_sum_mem _ _ _ fun c _ => Subgroup.subset_closure (Or.inl ⟨(i, c), rfl⟩)
  · rw [boxVec, if_neg hnd, xPauli_zero]; exact one_mem _

lemma zPauli_boxVec_mem (i : Fin l) (a b : r.Coord) : zPauli (r.boxVec i a b) ∈ r.gauge := by
  by_cases hnd : r.Nondeg i a b
  · rw [r.boxVec_eq_sum hnd]
    exact r.zPauli_sum_mem _ _ _ fun c _ => Subgroup.subset_closure (Or.inr ⟨(i, c), rfl⟩)
  · rw [boxVec, if_neg hnd, zPauli_zero]; exact one_mem _

/-- Rows of the CSS check matrix, as binary symplectic vectors. -/
lemma cssRow_castAdd (j : Fin (l * (r.n * r.n))) :
    (CSS_BSM r.stabMat' r.stabMat').row (Fin.castAdd _ j) = (0, r.stabMat' j) := by
  simp only [CSS_BSM, BinSympMatrix.row, Fin.append_left]; rfl

lemma cssRow_natAdd (j : Fin (l * (r.n * r.n))) :
    (CSS_BSM r.stabMat' r.stabMat').row (Fin.natAdd _ j) = (r.stabMat' j, 0) := by
  simp only [CSS_BSM, BinSympMatrix.row, Fin.append_right]; rfl

/-- A gauge generator commutes with every row of the stabilizer check matrix. -/
lemma gaugeGen_commute_row {g : PauliGroup_group r.n} (hg : g ∈ r.gaugeGens)
    (idx : Fin (l * (r.n * r.n) + l * (r.n * r.n))) :
    commute g (BinSympPauli_toPauli ((CSS_BSM r.stabMat' r.stabMat').row idx)) := by
  rcases hg with ⟨⟨i, c⟩, rfl⟩ | ⟨⟨i, c⟩, rfl⟩ <;>
  refine Fin.addCases (fun j => ?_) (fun j => ?_) idx <;>
  first
    | rw [cssRow_castAdd] | rw [cssRow_natAdd]
  all_goals
    apply commutes_of_sympProd_zero
    simp [symplecticProd, line_dot_box]

/-- Every stabilizer is a product of gauge lines. -/
theorem stabs_le_gauge : r.stabCode.stabs ≤ r.gauge := by
  change Subgroup.closure _ ≤ r.gauge
  rw [Subgroup.closure_le]
  intro s hs
  simp only [BinSympMatrix.toStabSet, Finset.coe_image, Set.mem_image, Finset.mem_coe,
    Finset.mem_univ, true_and] at hs
  obtain ⟨idx, rfl⟩ := hs
  refine Fin.addCases (fun j => ?_) (fun j => ?_) idx
  · rw [cssRow_castAdd]
    exact r.zPauli_boxVec_mem _ _ _
  · rw [cssRow_natAdd]
    exact r.xPauli_boxVec_mem _ _ _

/-- Every gauge line commutes with every stabilizer. -/
theorem gauge_le_centralizer :
    r.gauge ≤ Subgroup.centralizer (r.stabCode.stabs : Set (PauliGroup_group r.n)) := by
  rw [gauge, Subgroup.closure_le]
  intro g hg
  change g ∈ r.stabCode.normalizerGroup
  rw [r.stabCode.mem_normalizerGroup_of_closure rfl]
  intro s hs
  simp only [BinSympMatrix.toStabSet, Finset.coe_image, Set.mem_image, Finset.mem_coe,
    Finset.mem_univ, true_and] at hs
  obtain ⟨idx, rfl⟩ := hs
  exact r.gaugeGen_commute_row hg idx

noncomputable def toSubsystemCode : SubsystemCode r.n where
  toStabCode := r.stabCode
  gauge := r.gauge
  h_stab_le := r.stabs_le_gauge
  h_stab_central := r.gauge_le_centralizer

end RLG
